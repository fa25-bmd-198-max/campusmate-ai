# =============================================================
# CampusMate AI – Environment Variables
# =============================================================
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to source control.
# All variables must be prefixed with VITE_ to be exposed to
# the browser by Vite.
# =============================================================

# ── Supabase ──────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Groq AI (free — no billing required) ─────────────────────
# Get your free key at: https://console.groq.com → API Keys
# Key format: gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_GROQ_API_KEY=gsk_your-groq-api-key-here

# ── App ───────────────────────────────────────────────────────
# Base URL used for auth redirect links (no trailing slash)
VITE_APP_URL=http://localhost:5173
