# =============================================================
# CampusMate AI – Environment Variables
# =============================================================
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to source control.
# All variables must be prefixed with VITE_ to be exposed to
# the browser by Vite.
# =============================================================

# ── Supabase ──────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Google Gemini AI ──────────────────────────────────────────
# Generate a key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key

# ── App ───────────────────────────────────────────────────────
# Base URL used for auth redirect links (no trailing slash)
VITE_APP_URL=http://localhost:5173
